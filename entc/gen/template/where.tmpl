{{/* gotype: entgo.io/ent/entc/gen.Type */}}

{{ define "where" }}

{{- with extend $ "Package" $.Package -}}
	{{ template "header" . }}
{{ end }}

{{ with extend $ "WhereUsesWherePkg" false "WhereUsesEntfield" (eq $.Storage.Name "sql") }}
	{{ template "import" . }}
{{ end }}

{{ if eq $.Storage.Name "sql" }}
	// Field holds typed predicate/order handles for every comparable field of the {{ $.Name }} type.
	var Field = struct {
		{{- if $.HasOneFieldID }}
			{{- $kind := $.ID.HandleKind }}
			// ID is the handle for the id field.
			ID entfield.{{ $kind }}{{ if not (eq $kind "Time") }}[{{ if eq $kind "Enum" }}{{ trimPackage $.ID.Type.String $.Package }}{{ else }}{{ $.ID.Type }}{{ end }}]{{ end }}
		{{- end }}
		{{- range $f := $.Fields }}
			{{- $edgeName := $f.EdgeName }}
			{{- $kind := $f.HandleKind }}
			{{- if $edgeName }}
				// {{ $f.StructField }} is the handle for the {{ quote $f.Name }} field (backs the {{ quote $edgeName }} edge).
				{{ $f.StructField }} entfield.EdgeField[{{ $f.Type }}]
			{{- else if $f.IsJSON }}
				// {{ $f.StructField }} is the handle for the {{ quote $f.Name }} field.
				{{ $f.StructField }} entfield.JSON[{{ $f.Type }}]
			{{- else if $kind }}
				// {{ $f.StructField }} is the handle for the {{ quote $f.Name }} field.
				{{ $f.StructField }} entfield.{{ $kind }}{{ if not (eq $kind "Time") }}[{{ if eq $kind "Enum" }}{{ trimPackage $f.Type.String $.Package }}{{ else }}{{ $f.Type }}{{ end }}]{{ end }}
			{{- end }}
		{{- end }}
	}{
		{{- if $.HasOneFieldID }}
			{{- $kind := $.ID.HandleKind }}
			ID: entfield.New{{ $kind }}{{ if not (eq $kind "Time") }}[{{ if eq $kind "Enum" }}{{ trimPackage $.ID.Type.String $.Package }}{{ else }}{{ $.ID.Type }}{{ end }}]{{ end }}({{ $.ID.Constant }}, {{ printf "%q" $.ID.Name }}),
		{{- end }}
		{{- range $f := $.Fields }}
			{{- $edgeName := $f.EdgeName }}
			{{- $kind := $f.HandleKind }}
			{{- if $edgeName }}
				{{ $f.StructField }}: entfield.NewEdgeField[{{ $f.Type }}]({{ $f.Constant }}, {{ printf "%q" $edgeName }}),
			{{- else if $f.IsJSON }}
				{{ $f.StructField }}: entfield.NewJSON[{{ $f.Type }}]({{ printf "%q" $f.Name }}),
			{{- else if $kind }}
				{{- /* ValueScanner.<X>.Value is populated by the runtime package's init(),
				which runs AFTER this package's own var initializers (Go inits
				imports before importers). Capturing the method value directly
				here would freeze in the zero value. Wrap it in a closure over the
				package-level ValueScanner var instead, so the lookup happens at
				call time, once every init() has already run. */}}
				{{- /* col ({{ $f.Constant }}) is the DB column (may differ from the
				schema field name via field.StorageKey), used for predicates; name
				({{ printf "%q" $f.Name }}) is the schema-declared field name, used
				by assignment methods to route into entbuilder.Mutation — see
				entfield.String's doc comment. */}}
				{{ $f.StructField }}: entfield.New{{ $kind }}{{ if $f.HasValueScanner }}Scan{{ end }}{{ if not (eq $kind "Time") }}[{{ if eq $kind "Enum" }}{{ trimPackage $f.Type.String $.Package }}{{ else }}{{ $f.Type }}{{ end }}]{{ end }}({{ $f.Constant }}, {{ printf "%q" $f.Name }}{{ if $f.HasValueScanner }}, func(v {{ $f.Type }}) (driver.Value, error) { return ValueScanner.{{ $f.StructField }}.Value(v) }{{ end }}),
			{{- end }}
		{{- end }}
	}

	// Edge holds typed edge handles for every edge of the {{ $.Name }} type.
	var Edge = struct {
		{{- range $e := $.Edges }}
			// {{ $e.StructField }} is the handle for the {{ quote $e.Name }} edge.
			{{ $e.StructField }} entfield.Edge[predicate.{{ $e.Type.Name }}, {{ if $e.Type.HasCompositeID }}struct{}{{ else }}{{ $e.Type.ID.Type }}{{ end }}]
		{{- end }}
	}{
		{{- range $e := $.Edges }}
			{{- /* Check if the edge target type has a deleted_at field (soft delete). */}}
			{{- $edgeHasSoftDelete := false }}
			{{- range $f := $e.Type.Fields }}
				{{- if eq $f.Name "deleted_at" }}
					{{- $edgeHasSoftDelete = true }}
				{{- end }}
			{{- end }}
			{{- /* Same check on the junction of an M2M through-edge. The join row
			is its own record there, so a soft-deleted junction means the edge is
			gone even when both endpoints are live — and that has to be filtered
			on the junction, inside the neighbor subquery. */}}
			{{- $junctionHasSoftDelete := false }}
			{{- if and $e.M2M $e.Through }}
				{{- range $f := $e.Through.Fields }}
					{{- if eq $f.Name "deleted_at" }}
						{{- $junctionHasSoftDelete = true }}
					{{- end }}
				{{- end }}
			{{- end }}

			{{- if $.FeatureEnabled "sql/schemaconfig" }}
				{{- /* Mirror dialect/sql/query/step/ctxschemaconfig's schema-name resolution
				(see dialect/sql/feature/schemaconfig.tmpl) so Has/HasWith/OrderBy* route
				step.To.Schema/step.Edge.Schema the same way the classic per-edge codegen did. */}}
				{{- $schema := $e.Type.Name }}
				{{- if $e.OwnFK }}
					{{- $schema = $.Name }}
				{{- else if $e.M2M }}
					{{- if $e.Through }}
						{{- $schema = $e.Through.Name }}
					{{- else if $e.Inverse }}
						{{- $schema = print $e.Type.Name (pascal $e.Inverse) }}
					{{- else }}
						{{- $schema = print $.Name $e.StructField }}
					{{- end }}
				{{- end }}
				{{ $e.StructField }}: entfield.NewEdgeSteps[predicate.{{ $e.Type.Name }}, {{ if $e.Type.HasCompositeID }}struct{}{{ else }}{{ $e.Type.ID.Type }}{{ end }}]({{ printf "%q" $e.Name }}, new{{ pascal $e.Name }}Step, []func(*sql.Selector, *sqlgraph.Step){
					func(s *sql.Selector, step *sqlgraph.Step) {
						schemaConfig := internal.SchemaConfigFromContext(s.Context())
						step.To.Schema = schemaConfig.{{ $e.Type.Name }}
						step.Edge.Schema = schemaConfig.{{ $schema }}
					},
				}{{ if $edgeHasSoftDelete }}, sql.FieldIsNull("deleted_at"){{ end }}){{ if $junctionHasSoftDelete }}.WithJunction({{ template "dialect/sql/edge/junctionfilter" $ }}){{ end }},
			{{- else }}
				{{ $e.StructField }}: entfield.NewEdge[predicate.{{ $e.Type.Name }}, {{ if $e.Type.HasCompositeID }}struct{}{{ else }}{{ $e.Type.ID.Type }}{{ end }}]({{ printf "%q" $e.Name }}, new{{ pascal $e.Name }}Step{{ if $edgeHasSoftDelete }}, sql.FieldIsNull("deleted_at"){{ end }}){{ if $junctionHasSoftDelete }}.WithJunction({{ template "dialect/sql/edge/junctionfilter" $ }}){{ end }},
			{{- end }}
		{{- end }}
	}
{{ else }}
	{{/*
	entfield handles are SQL-only (they're built on *sql.Selector). Non-sql
	storage drivers (gremlin) keep the classic per-field/per-edge predicate
	functions below, unchanged.
	*/}}
	{{ if .HasOneFieldID }}
		// ID filters vertices based on their ID field.
		func ID(id {{ $.ID.Type }}) predicate.{{ $.Name }} {
			return predicate.{{ $.Name }}(
				{{- $tmpl := printf "dialect/%s/predicate/id" $.Storage }}
				{{- xtemplate $tmpl $ -}}
			)
		}

		{{ range $op := $.ID.Ops }}
			{{ $arg := "id" }}{{ if $op.Variadic }}{{ $arg = "ids" }}{{ end }}
			{{ $func := printf "ID%s" $op.Name }}
			// {{ $func }} applies the {{ $op.Name }} predicate on the ID field.
			func {{ $func }}({{ $arg }} {{ if $op.Variadic }}...{{ end }}{{ $.ID.Type }}) predicate.{{ $.Name }} {
				return predicate.{{ $.Name }}(
					{{- with extend $ "Arg" $arg "Op" $op "Storage" $.Storage -}}
						{{ $tmpl := printf "dialect/%s/predicate/id/ops" $.Storage }}
						{{- xtemplate $tmpl . }}
					{{- end -}}
				)
			}
		{{ end }}
	{{ end }}

	{{ range $f := $.Fields }}
		{{ $func := $f.StructField }}
		{{/* JSON cannot be compared using "=" and Enum has a type defined with the field name */}}
		{{ $hasP := not (or $f.IsJSON $f.IsEnum) }}
		{{ $comparable := or $f.ConvertedToBasic $f.Type.Valuer }}
		{{ $undeclared := (and (ne $func "Label") (ne $func "OrderOption") (ne $func "Hooks") (ne $func "Policy") (ne $func "Table") (ne $func "FieldID") (ne $func "Value") (ne $func $.Name)) }}
		{{- if and $hasP $comparable $undeclared }}
			{{ $arg := "v" }}
			// {{ $func }} applies equality check predicate on the {{ quote $f.Name }} field. It's identical to {{ $func }}EQ.
			func {{ $func }}({{ $arg }} {{ $f.Type }}) predicate.{{ $.Name }} {
				{{- if $f.HasValueScanner }}
					vc, err := ValueScanner.{{ $f.StructField }}.Value({{ $arg }})
					{{- $arg = "vc" }}
					return predicate.{{ $.Name }}OrErr(
						{{- with extend $ "Arg" $arg "Field" $f -}}
							{{ $tmpl := printf "dialect/%s/predicate/field" $.Storage }}
							{{- xtemplate $tmpl . }}
						{{- end }}, err)
				{{- else }}
					{{- if and $f.HasGoType (not $f.Type.Valuer) }}
						vc := {{ $f.BasicType "v" }}
						{{- $arg = "vc" }}
					{{- end }}
					return predicate.{{ $.Name }}(
						{{- with extend $ "Arg" $arg "Field" $f -}}
							{{ $tmpl := printf "dialect/%s/predicate/field" $.Storage }}
							{{- xtemplate $tmpl . }}
						{{- end -}}
					)
				{{- end }}
			}
		{{- end }}
	{{ end }}

	{{ range $f := $.Fields }}
		{{ range $op := $f.Ops }}
			{{ $arg := "v" }}{{ if $op.Variadic }}{{ $arg = "vs" }}{{ end }}
			{{ $stringOp := eq $op.Name "EqualFold" "Contains" "ContainsFold" "HasPrefix" "HasSuffix" }}
			{{ $func := print $f.StructField $op.Name }}
			{{ $type := $f.Type.String }}{{ if $f.IsEnum }}{{ $type = trimPackage $type $.Package }}{{ end }}
			// {{ $func }} applies the {{ $op.Name }} predicate on the {{ quote $f.Name }} field.
			func {{ $func }}({{ if not $op.Niladic }}{{ $arg }} {{ if $op.Variadic }}...{{ end }}{{ $type }}{{ end }}) predicate.{{ $.Name }} {
				{{- if and $f.HasValueScanner (or $op.Variadic (not $op.Niladic)) }}
					{{- if $op.Variadic }}
						var (
							err error
							v = make([]any, len({{ $arg }}))
						)
						for i := range v {
							if v[i], err = ValueScanner.{{ $f.StructField }}.Value({{ print $arg "[i]" }}); err != nil {
								break
							}
						}
						{{- $arg = "v" }}
					{{- else }}
						vc, err := ValueScanner.{{ $f.StructField }}.Value({{ $arg }})
						{{- $arg = "vc" }}
						{{- if $stringOp }}
							{{- $arg = "vcs" }}
							vcs, ok := vc.(string)
							if err == nil && !ok {
								err = fmt.Errorf("{{ $f.Name }} value is not a string: %T", vc)
							}
						{{- end }}
					{{- end }}
					return predicate.{{ $.Name }}OrErr(
						{{- with extend $ "Arg" $arg "Field" $f "Op" $op "Storage" $.Storage -}}
							{{ $tmpl := printf "dialect/%s/predicate/field/ops" $.Storage }}
							{{- xtemplate $tmpl . }}
						{{- end }}, err)
				{{- else }}
					{{- if and $f.HasGoType (or $stringOp (not $f.Type.Valuer)) }}
						{{- if $op.Variadic }}
							v := make([]any, len({{ $arg }}))
							for i := range v {
								v[i] = {{ $f.BasicType (printf "%s[i]" $arg) }}
							}
							{{- $arg = "v" }}
						{{- else if not $op.Niladic }}
							vc := {{ $f.BasicType "v" }}
							{{- $arg = "vc" }}
						{{- end }}
					{{- end }}
					return predicate.{{ $.Name }}(
						{{- with extend $ "Arg" $arg "Field" $f "Op" $op "Storage" $.Storage -}}
							{{ $tmpl := printf "dialect/%s/predicate/field/ops" $.Storage }}
							{{- xtemplate $tmpl . }}
						{{- end -}}
					)
				{{- end }}
			}
		{{ end }}
	{{ end }}

	{{ range $e := $.Edges }}
		{{ $func := print "Has" $e.StructField }}
		// {{ $func }} applies the HasEdge predicate on the {{ quote $e.Name }} edge.
		func {{ $func }}() predicate.{{ $.Name }} {
			return predicate.{{ $.Name }}(
				{{- with extend $ "Edge" $e -}}
					{{ $tmpl := printf "dialect/%s/predicate/edge/has" $.Storage }}
					{{- xtemplate $tmpl . }}
				{{- end -}}
			)
		}
		{{ $func = printf "%sWith" $func }}
		// {{ $func }} applies the HasEdge predicate on the {{ quote $e.Name }} edge with a given conditions (other predicates).
		func {{ $func }}(preds ...predicate.{{ $e.Type.Name }}) predicate.{{ $.Name }} {
			return predicate.{{ $.Name }}(
				{{- with extend $ "Edge" $e -}}
					{{ $tmpl := printf "dialect/%s/predicate/edge/haswith" $.Storage }}
					{{- xtemplate $tmpl . }}
				{{- end -}}
			)
		}
	{{ end }}
{{ end }}

// And groups predicates with the AND operator between them.
func And(predicates ...predicate.{{ $.Name }}) predicate.{{ $.Name }} {
	return predicate.{{ $.Name }}(
		{{- $tmpl := printf "dialect/%s/predicate/and" $.Storage }}
		{{- xtemplate $tmpl . -}}
	)
}

// Or groups predicates with the OR operator between them.
func Or(predicates ...predicate.{{ $.Name }}) predicate.{{ $.Name }} {
	return predicate.{{ $.Name }}(
		{{- $tmpl = printf "dialect/%s/predicate/or" $.Storage }}
		{{- xtemplate $tmpl . -}}
	)
}

// Not applies the not operator on the given predicate.
func Not(p predicate.{{ $.Name }}) predicate.{{ $.Name }} {
	return predicate.{{ $.Name }}(
		{{- $tmpl = printf "dialect/%s/predicate/not" $.Storage }}
		{{- xtemplate $tmpl . -}}
	)
}

{{ template "where/additional" $ }}

{{ with $tmpls := matchTemplate "where/additional/*" }}
	{{ range $tmpl := $tmpls }}
		{{ xtemplate $tmpl $ }}
	{{ end }}
{{ end }}

{{ end }}

{{/* A template that can be overridden in order to add additional code for the type package. */}}
{{ define "where/additional" }}{{ end }}

{{/* The junction-table filter applied inside Has/HasWith for an M2M
through-edge whose join entity is soft-deletable. Defined separately so a
project can override it — the deleted_at convention is ent's, but whether a
query may opt out of it (a "show deleted too" context, say) is the project's. */}}
{{ define "dialect/sql/edge/junctionfilter" -}}
	func(sel *sql.Selector, t *sql.SelectTable) { sel.Where(sql.IsNull(t.C("deleted_at"))) }
{{- end }}
