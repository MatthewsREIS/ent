{{/* gotype: entgo.io/ent/entc/gen.typeScope */}}

{{/* Additional fields for the builder. */}}
{{ define "dialect/sql/update/fields" }}
	{{- with $tmpls := matchTemplate "dialect/sql/update/fields/additional/*" }}
		{{- range $tmpl := $tmpls }}
			{{- xtemplate $tmpl $ }}
		{{- end }}
	{{- end }}
{{- end }}

{{ define "dialect/sql/update" }}
{{ $pkg := $.Scope.Package }}
{{ $builder := pascal $.Scope.Builder }}
{{ $receiver := $.Scope.Receiver }}
{{ $mutation := print $receiver ".mutation" }}
{{ $one := hasSuffix $builder "One" }}
{{- $zero := 0 }}{{ if $one }}{{ $zero = "nil" }}{{ end }}

{{- /* Allow adding methods to the update-builder by ent extensions or user templates.*/}}
{{- with $tmpls := matchTemplate "dialect/sql/update/additional/*" }}
	{{- range $tmpl := $tmpls }}
		{{- xtemplate $tmpl $ }}
	{{- end }}
{{- end }}

func ({{ $receiver }} *{{ $builder }}) sqlSave(ctx context.Context) (_node {{ if $one }}*{{ $.Name }}{{ else }}int{{ end }}, err error) {
	{{- if $.HasUpdateCheckers }}
		if err := {{ $receiver }}.check(); err != nil {
			return _node, err
		}
	{{- end }}
	_spec := sqlgraph.NewUpdateSpec({{ $.PackageQualifier }}Table, {{ $.PackageQualifier }}Columns,
		{{- if $.HasOneFieldID -}}
			sqlgraph.NewFieldSpec({{ $.PackageQualifier }}{{ $.ID.Constant }}, field.{{ $.ID.Type.ConstName }})
		{{- else -}}
			{{- range $id := $.EdgeSchema.ID -}}
				sqlgraph.NewFieldSpec({{ $.PackageQualifier }}{{ $id.Constant }}, field.{{ $id.Type.ConstName }}),
			{{- end -}}
		{{- end }})
	{{- if $one }}
		{{- if $.HasOneFieldID }}
			id, ok := {{ $mutation }}.ID()
			if !ok {
				return {{ $zero }}, &ValidationError{Name: "{{ $.ID.Name }}", Err: errors.New(`{{ $pkg }}: missing "{{ $.Name }}.{{ $.ID.Name }}" for update`)}
			}
			_spec.Node.ID.Value = id
			if fields := {{ $receiver }}.fields; len(fields) > 0 {
				_spec.Node.Columns = make([]string, 0, len(fields))
				_spec.Node.Columns = append(_spec.Node.Columns, {{ $.PackageQualifier }}{{ $.ID.Constant }})
				for _, f := range fields {
					if !{{ $.PackageQualifier }}ValidColumn(f) {
						return nil, &ValidationError{Name: f, Err: fmt.Errorf("{{ $pkg }}: invalid field %q for query", f)}
					}
					if f != {{ $.PackageQualifier }}{{ $.ID.Constant }} {
						_spec.Node.Columns = append(_spec.Node.Columns, f)
					}
				}
			}
		{{- else }}{{/* Composite ID. */}}
			{{- range $i, $id := $.EdgeSchema.ID }}
				{{- $edgeName := $id.EdgeName }}
				{{- if $edgeName }}
				if rawID, ok := {{ $mutation }}.EdgeID({{ printf "%q" $edgeName }}); !ok {
					return {{ $zero }}, &ValidationError{Name: "{{ $id.Name }}", Err: errors.New(`{{ $pkg }}: missing "{{ $.Name }}.{{ $id.Name }}" for update`)}
				} else {
					_spec.Node.CompositeID[{{ $i }}].Value = rawID.({{ trimPackage $id.Type.String $.Package }})
				}
				{{- else }}
				if id, ok := entbuilder.GetField[{{ trimPackage $id.Type.String $.Package }}]({{ $mutation }}, {{ printf "%q" $id.Name }}); !ok {
					return {{ $zero }}, &ValidationError{Name: "{{ $id.Name }}", Err: errors.New(`{{ $pkg }}: missing "{{ $.Name }}.{{ $id.Name }}" for update`)}
				} else {
					_spec.Node.CompositeID[{{ $i }}].Value = id
				}
				{{- end }}
			{{- end }}
			if fields := {{ $receiver }}.fields; len(fields) > 0 {
				_spec.Node.Columns = make([]string, len(fields))
				for i, f := range fields {
					if !{{ $.PackageQualifier }}ValidColumn(f) {
						return nil, &ValidationError{Name: f, Err: fmt.Errorf("{{ $pkg }}: invalid field %q for query", f)}
					}
					_spec.Node.Columns[i] = f
				}
			}
		{{- end }}
	{{- end }}
	entbuilder.ApplyUpdateSpec({{ $mutation }}, _spec, {{ if $.FeatureEnabled "sql/schemaconfig" }}internal.SchemaOf({{ $receiver }}.Config){{ else }}nil{{ end }}, {{ with extend $ "SkipImmutable" true }}{{ template "dialect/sql/throughdefaults" . }}{{ end }})
	{{- /* HasValueScanner fields are excluded from ApplyUpdateSpec's SetField/
	      AddField (see runtime/entbuilder.FieldSpec.HasValueScanner) — this
	      residual block converts them via the field's ValueFunc first, same
	      as the pre-applier unroll. Empty range for every field/entity in
	      this fork's corpus today (none declares an external ValueScanner). */}}
	{{- range $f := $.MutationFields }}
		{{- if and $f.HasValueScanner (or (not $f.Immutable) $f.UpdateDefault) }}
			if value, ok := entbuilder.GetField[{{ trimPackage $f.Type.String $.Package }}]({{ $mutation }}, {{ printf "%q" $f.Name }}); ok {
				vv, err := {{ trimPackage $f.ValueFunc $.Package }}(value)
				if err != nil {
					return {{ $zero }}, err
				}
				_spec.SetField({{ $.PackageQualifier }}{{ $f.Constant }}, field.{{ $f.Type.ConstName }}, vv)
			}
			{{- if $f.SupportsMutationAdd }}
				if added, ok := {{ $mutation }}.AddedField({{ printf "%q" $f.Name }}); ok {
					value := added.({{ trimPackage $f.Type.String $.Package }})
					vv, err := {{ trimPackage $f.ValueFunc $.Package }}(value)
					if err != nil {
						return {{ $zero }}, err
					}
					_spec.AddField({{ $.PackageQualifier }}{{ $f.Constant }}, field.{{ $f.Type.ConstName }}, vv)
				}
			{{- end }}
		{{- end }}
	{{- end }}
	{{- /* Allow mutating the sqlgraph.UpdateSpec by ent extensions or user templates.*/}}
	{{- with $tmpls := matchTemplate "dialect/sql/update/spec/*" }}
		{{- range $tmpl := $tmpls }}
			{{- xtemplate $tmpl $ }}
		{{- end }}
	{{- end }}
	{{- if $one }}
		_node = &{{ $.Name }}{Config: {{ $receiver }}.Config}
		_spec.Assign = _node.AssignValues
		_spec.ScanValues = _node.ScanValues
	{{- end }}
	{{- if $one }}
		if err = sqlgraph.UpdateNode(ctx, {{ $receiver }}.Drv, _spec); err != nil {
	{{- else }}
		if _node, err = sqlgraph.UpdateNodes(ctx, {{ $receiver }}.Drv, _spec); err != nil {
	{{- end }}
		if _, ok := err.(*sqlgraph.NotFoundError); ok {
			err = &NotFoundError{Label: {{ $.PackageQualifier }}Label}
		} else if sqlgraph.IsConstraintError(err) {
			err = &ConstraintError{Msg: err.Error(), Wrap: err}
		}
		return {{ $zero }}, err
	}
	{{ $mutation }}.SetDone()
	return _node, nil
}
{{ end }}

{{/* dialect/sql/throughdefaults builds the throughDefaults map argument for
    entbuilder.ApplyUpdateSpec/ApplyCreateSpec: one entry per edge whose
    Through (edge-schema) type has default field values, else the literal
    nil (the common case — most entities have no such edge). Mirrors the
    $e.Through block that used to live in the now-deleted "dialect/sql/
    defedge" template (edge-spec construction itself is now generic, see
    runtime/entbuilder.ApplyUpdateSpec/ApplyCreateSpec's build() closure).
    $.Scope.SkipImmutable opts out immutable edges (update.tmpl only —
    create.tmpl's edge loop has never skipped them, since an immutable edge
    can still be set at creation time). */}}
{{ define "dialect/sql/throughdefaults" }}
	{{- $receiver := $.Scope.Receiver -}}
	{{- $entries := list -}}
	{{- range $e := $.EdgesWithID }}
		{{- if and $.Scope.SkipImmutable $e.Immutable }}{{ continue }}{{ end }}
		{{- with $e.Through }}
			{{- if .HasDefault }}
				{{- $entries = append $entries $e }}
			{{- end }}
		{{- end }}
	{{- end }}
	{{- if not $entries }}nil{{ else }}
map[string]func() []*sqlgraph.FieldSpec{
	{{- range $e := $entries }}
		{{- $through := $e.Through }}
	{{ $e.Name | printf "%q" }}: func() []*sqlgraph.FieldSpec {
		{{- if $.Scope.InSubPackage }}
		specE := {{ $through.PackageDir }}.ThroughDefaults({{ $receiver }}.Config)
		{{- else }}
		createE := &{{ $through.CreateName }}{Config: {{ $receiver }}.Config, mutation: new{{ $through.MutationName }}({{ $receiver }}.Config, OpCreate)}
		{{- /* Skip error handling here as this check was already handled. */}}
		{{ if or $through.NumHooks $through.NumPolicy }}_ = {{ end }}createE.defaults()
		_, specE := createE.createSpec()
		{{- end }}
		fields := specE.Fields
		{{- if and $through.HasOneFieldID $through.ID.Default }}
		if specE.ID.Value != nil {
			fields = append(fields, specE.ID)
		}
		{{- end }}
		return fields
	},
	{{- end }}
}
	{{- end }}
{{- end }}
