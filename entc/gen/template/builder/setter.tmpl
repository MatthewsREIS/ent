{{/* gotype: entgo.io/ent/entc/gen.Type */}}

{{ define "setter" }}
{{ $builder := pascal $.Scope.Builder }}
{{ $receiver := $.Scope.Receiver }}

{{/*
All per-field/per-edge setters (SetX/SetNillableX/AddX/AppendX/ClearX,
Set/AddX(ID(s))/RemoveXIDs/ClearX for edges) are gone: that surface now
lives on the entfield handles (F/E, see where.tmpl) as field/edge-assignment
methods, applied here via With. Dialect-independent: gremlin builders get
With too, since *entbuilder.Mutation[T, I] satisfies entfield.Mutable
regardless of storage.
*/}}

// With applies field/edge handle assignments (Field.<Field>.Set(...), Edge.<Edge>.SetID(...), ...)
// to the {{ $builder }} builder. The first error from as is recorded and returned by Save.
func ({{ $receiver }} *{{ $builder }}) With(as ...entfield.Assignment) *{{ $builder }} {
	if {{ $receiver }}.err == nil {
		{{ $receiver }}.err = entfield.Apply({{ $receiver }}.mutation, as...)
	}
	return {{ $receiver }}
}

// Mutation returns the {{ $.MutationName }} object of the builder.
func ({{ $receiver }} *{{ $builder }}) Mutation() *{{ $.MutationName }} {
	return {{ $receiver }}.mutation
}

{{ end }}
