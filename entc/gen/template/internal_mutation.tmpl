{{/* gotype: entgo.io/ent/entc/gen.Type */}}

{{ define "internal/mutation" }}

{{ $n := $ }}

{{ with extend $ "Package" "internal" }}
	{{ template "header" . }}
{{ end }}

import (
	"context"
	"reflect"

	"entgo.io/ent"
	"entgo.io/ent/dialect/sql"
	"entgo.io/ent/runtime/entbuilder"
	{{- if eq $n.Storage.Name "sql" }}
	"entgo.io/ent/dialect/sql/sqlgraph"
	"entgo.io/ent/schema/field"
	{{- end }}

	"{{ $.Config.Package }}/predicate"
	{{- /* Import field types, but skip entity sub-packages to avoid cycles (enums defined in internal). */ -}}
	{{- $seen := dict }}
	{{- $fields := $.Fields }}{{ if $.HasOneFieldID }}{{ if $.ID.UserDefined }}{{ $fields = append $fields $.ID }}{{ end }}{{ end }}
	{{- range $f := $fields }}
		{{- $pkg := $f.Type.PkgPath }}
		{{- $isSchemaPkg := or (hasSuffix $pkg "/schema") (hasPrefix $pkg (printf "%s/schema/" $.Config.Package)) -}}
		{{- if and $pkg (not (hasImport (base $pkg))) (not (hasKey $seen $pkg)) (or (not (hasPrefix $pkg (printf "%s/" $.Config.Package))) $isSchemaPkg) }}
			{{- $name := $f.Type.PkgName }}
			{{ if ne $name (base $pkg) }}{{ $name }} {{ end}}"{{ $pkg }}"
			{{- $seen = set $seen $pkg true }}
		{{- end }}
	{{- end }}
)

{{ $mutation := $n.MutationName }}

{{- /* IDType: the second type parameter on entbuilder.Mutation[T, I]. For
       single-ID entities this is the schema-declared ID type so m.ID()
       returns the typed value (uuid.UUID, int, etc.). Entities without a
       single-field ID fall back to `any`, matching the pre-typed-I behavior. */ -}}

// {{ $mutation }} is an alias for entbuilder.Mutation parameterised by {{ $n.Name }}.
type {{ $mutation }} = entbuilder.Mutation[{{ $n.Name }}, {{ if $n.HasOneFieldID }}{{ $n.ID.Type }}{{ else }}any{{ end }}]

// {{ $mutation }}Option is a functional option for {{ $mutation }}.
type {{ $mutation }}Option = func(*{{ $mutation }})

// {{ $n.Package }}Descriptor describes {{ $n.Name }}'s fields and edges
// for the generic mutation runtime.
var {{ $n.Package }}Descriptor = &entbuilder.Descriptor{
	Name:   {{ $n.Name | printf "%q" }},
	{{- with $n.HasOneFieldID }}
	IDType: reflect.TypeFor[{{ $n.ID.Type }}](),
	{{- end }}
	{{- if and $n.HasOneFieldID $n.ID.UserDefined }}
	IDField: {{ $n.ID.Name | printf "%q" }},
	{{- end }}
	Fields: map[string]entbuilder.FieldSpec{
		{{- range $f := $n.MutationFields }}
		{{ $f.Name | printf "%q" }}: {
			Type:   reflect.TypeFor[{{ if and ($f.IsEnum) (not $f.HasGoType) }}{{ $n.Name }}{{ trimPackage $f.Type.String $n.Package }}{{ else }}{{ $f.Type }}{{ end }}](),
			GoName: {{ $f.StructField | printf "%q" }},
			{{- if or $f.Optional $f.Nillable }}
			Nillable: true,
			{{- end }}
			{{- if $f.SupportsMutationAdd }}
			Numeric: true,
			{{- end }}
			{{- if $f.Immutable }}
			Immutable: true,
			{{- end }}
			{{- if eq $n.Storage.Name "sql" }}
			Column:  {{ $f.StorageKey | printf "%q" }},
			SQLType: field.{{ $f.Type.ConstName }},
			{{- if $f.HasValueScanner }}
			HasValueScanner: true,
			{{- end }}
			{{- end }}
		},
		{{- end }}
	},
	Edges: map[string]entbuilder.EdgeSpec{
		{{- range $e := $n.EdgesWithID }}
		{{ $e.Name | printf "%q" }}: {
			Cardinality:  {{ if $e.Unique }}entbuilder.O2OUnique{{ else if $e.M2M }}entbuilder.M2M{{ else if $e.M2O }}entbuilder.M2O{{ else }}entbuilder.O2M{{ end }},
			Target:       {{ $e.Type.Name | printf "%q" }},
			TargetIDType: reflect.TypeFor[{{ $e.Type.ID.Type }}](),
			{{- if $e.Inverse }}
			Inverse: true,
			{{- end }}
			{{- with $e.Field }}
			Field: {{ .Name | printf "%q" }},
			{{- end }}
			{{- if $e.Immutable }}
			Immutable: true,
			{{- end }}
			{{- if eq $n.Storage.Name "sql" }}
			Rel:            sqlgraph.{{ $e.Rel.Type }},
			StorageTable:   {{ $e.Rel.Table | printf "%q" }},
			StorageColumns: []string{ {{- range $i, $c := $e.Rel.Columns }}{{ if $i }}, {{ end }}{{ $c | printf "%q" }}{{- end }} },
			{{- if $e.Bidi }}
			Bidi: true,
			{{- end }}
			TargetIDColumn:  {{ $e.Type.ID.StorageKey | printf "%q" }},
			TargetIDSQLType: field.{{ $e.Type.ID.Type.ConstName }},
			{{- if $e.OwnFK }}
			{{- /* Mirrors create.tmpl's $e.OwnFK node-assignment guard verbatim
			      (InSubPackage is always true in this fork's codegen — see
			      entc/gen/graph.go's typeScope construction — so only that
			      branch is ever reachable). */}}
			{{- $fk := $e.ForeignKey }}
			{{- if eq (pascal $fk.StructField) $fk.StructField }}
			NodeField: {{ $fk.StructField | printf "%q" }},
			{{- end }}
			{{- end }}
			{{- if $n.FeatureEnabled "sql/schemaconfig" }}
			{{- /* Mirrors schemaconfig.tmpl's "dialect/sql/defedge/spec/schemaconfig"
			      $schema derivation verbatim — the literal SchemaConfig struct-field
			      name resolved at runtime by schemaOf(desc.Edges[name].SchemaKey). */}}
			{{- $schema := $e.Type.Name }}
			{{- if $e.OwnFK }}
				{{- $schema = $n.Name }}
			{{- else if $e.M2M }}
				{{- if $e.Through }}
					{{- $schema = $e.Through.Name }}
				{{- else if $e.Inverse }}
					{{- $schema = print $e.Type.Name (pascal $e.Inverse) }}
				{{- else }}
					{{- $schema = print $n.Name $e.StructField }}
				{{- end }}
			{{- end }}
			SchemaKey: {{ $schema | printf "%q" }},
			{{- end }}
			{{- end }}
		},
		{{- end }}
	},
	{{- if eq $n.Storage.Name "sql" }}
	Table: {{ $n.Table | printf "%q" }},
	TableColumns: []string{
		{{- with $n.HasOneFieldID }}
		{{ $n.ID.StorageKey | printf "%q" }},
		{{- end }}
		{{- range $f := $n.Fields }}
		{{- if not $f.IsDeprecated }}
		{{ $f.StorageKey | printf "%q" }},
		{{- end }}
		{{- end }}
	},
	{{- with $n.HasOneFieldID }}
	IDColumn:  {{ $n.ID.StorageKey | printf "%q" }},
	IDSQLType: field.{{ $n.ID.Type.ConstName }},
	{{- end }}
	{{- if $n.FeatureEnabled "sql/schemaconfig" }}
	SchemaKey: {{ $n.Name | printf "%q" }},
	{{- end }}
	{{- if $n.FeatureEnabled "entql" }}
	{{- /* GraphFields/GraphEdges/CompositeID feed BuildSchemaGraph (the
	      shared entql schema graph in internal/types.go) — a superset of
	      Fields/Edges above, which are scoped to what mutation Set/Add/
	      Clear needs. See runtime/entbuilder.Descriptor's doc comments on
	      these three fields for exactly what/why each one adds. */}}
	GraphFields: map[string]field.Type{
		{{- range $f := $n.Fields }}
		{{ $f.StorageKey | printf "%q" }}: field.{{ $f.Type.ConstName }},
		{{- end }}
	},
	GraphEdges: map[string]entbuilder.EdgeSpec{
		{{- range $e := $n.Edges }}
		{{ $e.Name | printf "%q" }}: {
			Target: {{ $e.Type.Name | printf "%q" }},
			Rel:    sqlgraph.{{ $e.Rel.Type }},
			{{- if $e.Inverse }}
			Inverse: true,
			{{- end }}
			StorageTable:   {{ $e.Rel.Table | printf "%q" }},
			StorageColumns: []string{ {{- range $i, $c := $e.Rel.Columns }}{{ if $i }}, {{ end }}{{ $c | printf "%q" }}{{- end }} },
			{{- if $e.Bidi }}
			Bidi: true,
			{{- end }}
		},
		{{- end }}
	},
	{{- if not $n.HasOneFieldID }}
	CompositeID: []entbuilder.IDColumnSpec{
		{{- range $id := $n.EdgeSchema.ID }}
		{Column: {{ $id.StorageKey | printf "%q" }}, SQLType: field.{{ $id.Type.ConstName }}},
		{{- end }}
	},
	{{- end }}
	{{- end }}
	{{- end }}
	{{- /* OldValueFn / IDsFn intentionally omitted: the entity client (e.g. *ent.Client.Task)
	      that owns Get/Query is not reachable from internal.Config. Per-mutation closures wired
	      via With{{ $n.Name }}ID / With{{ $n.Name }}IDsFunc supply the same plumbing through
	      Mutation.SetOldValueLoader / SetIDsFunc, which is what runtime actually invokes today. */ -}}
}

// New{{ $mutation }} creates a new mutation for the {{ $n.Name }} entity.
func New{{ $mutation }}(c Config, op Op, opts ...{{ $mutation }}Option) *{{ $mutation }} {
	return entbuilder.NewMutation[{{ $n.Name }}, {{ if $n.HasOneFieldID }}{{ $n.ID.Type }}{{ else }}any{{ end }}](&c, op, {{ $n.Package }}Descriptor, opts...)
}

{{ with $n.HasOneFieldID }}
// With{{ $n.Name }}ID sets the ID field and old-value loader of the mutation.
// The getFunc callback fetches the old entity value for OldField support.
// If getFunc is nil, the old-value loader is not set (used by DeleteOneID).
func With{{ $n.Name }}ID(id {{ $n.ID.Type }}, getFunc func(context.Context, {{ $n.ID.Type }}) (*{{ $n.Name }}, error)) {{ $mutation }}Option {
	return func(m *{{ $mutation }}) {
		m.SetID(id)
		if getFunc != nil {
			m.SetOldValueLoader(func(ctx context.Context) (any, error) { return getFunc(ctx, id) })
		}
	}
}

// With{{ $n.Name }} sets the old {{ $n.Name }} of the mutation.
func With{{ $n.Name }}(node *{{ $n.Name }}) {{ $mutation }}Option {
	return func(m *{{ $mutation }}) {
		m.SetID(node.{{ $n.ID.StructField }})
		m.SetOldValueLoader(func(context.Context) (any, error) { return node, nil })
	}
}

// With{{ $n.Name }}IDsFunc sets the function used to query entity IDs.
func With{{ $n.Name }}IDsFunc(fn func(context.Context, ...predicate.{{ $n.Name }}) ([]{{ $n.ID.Type }}, error)) {{ $mutation }}Option {
	return func(m *{{ $mutation }}) {
		m.SetIDsFunc(func(ctx context.Context, preds ...func(*sql.Selector)) ([]any, error) {
			ps := make([]predicate.{{ $n.Name }}, len(preds))
			for i, p := range preds { ps[i] = p }
			ids, err := fn(ctx, ps...)
			if err != nil { return nil, err }
			out := make([]any, len(ids))
			for i, id := range ids { out[i] = id }
			return out, nil
		})
	}
}
{{ end }}

{{- /* Additional fields can be added by fork-specific xtemplate hooks. */}}
{{- with $tmpls := matchTemplate "mutation/fields/*"  }}
	{{- range $tmpl := $tmpls }}
		{{- xtemplate $tmpl $n }}
	{{- end }}
{{- end }}

{{ end }}
